# Public origin. Set this in Vercel → Settings → Environment Variables for Production.
SITE_URL=https://madesaint.store

# Optional. Without these, reservations are recorded unpaid.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional. Protects customer details on /launch?token=… and GET /api/preorders?token=…
# Also required in production for /admin/visual-atelier.
# ADMIN_TOKEN=

# Visual Atelier. Without this key the atelier can plan a batch but will not call OpenAI and will not invent images.
# OPENAI_API_KEY=
# Optional. Pause a running batch once recorded cost reaches this many US dollars.
# ATELIER_SPEND_CEILING_USD=
