# Public origin. Set this in Vercel → Settings → Environment Variables for Production.
SITE_URL=https://madesaint.store

# Optional. Without these, reservations are recorded unpaid.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional. Protects customer details on /launch?token=… and GET /api/preorders?token=…
# ADMIN_TOKEN=
